{
  "name": "todo-ticket",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "displayName": "P08 ToDo-Ticket",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:abnahme && npm run test:speichern && npm run test:bausteine",
    "test:abnahme": "esbuild tests/abnahme.ts --bundle --platform=node --format=esm --external:exceljs --outfile=tests/.abnahme.mjs --log-level=error && node tests/.abnahme.mjs",
    "test:speichern": "esbuild tests/speichern.ts --bundle --platform=node --format=esm --external:exceljs --outfile=tests/.speichern.mjs --log-level=error && node tests/.speichern.mjs",
    "test:bausteine": "esbuild tests/bausteine.ts --bundle --platform=node --format=esm --external:exceljs --outfile=tests/.bausteine.mjs --log-level=error && node tests/.bausteine.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^3.27.0",
    "exceljs": "^4.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
